# Resend API key for contact form, quote form, and newsletter emails
# Get this from https://resend.com after creating an account
RESEND_API_KEY=

# Optional: Resend Audience ID for newsletter subscriptions
# If left empty, newsletter signups are sent as an email notification instead
RESEND_AUDIENCE_ID=

# Google Analytics Measurement ID (gtag.js)
NEXT_PUBLIC_GA_ID=G-R9VQ3LQRX1

# ── Admin panel credentials ───────────────────────────────────────────────────
# These are read SERVER-SIDE only. Never expose them to the browser.
# Set these in Vercel > Project Settings > Environment Variables.
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=

# ── Admin session signing secret ──────────────────────────────────────────────
# A random 32+ character string used to sign the HttpOnly session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ── Site URL (used for CSRF origin validation) ────────────────────────────────
# Must match your production domain exactly (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://yagwatech.com
